# ---------------------------------------------------------------------------
# FISCA — contoh environment. Salin ke `.env` dan jangan commit `.env`.
# ---------------------------------------------------------------------------

# api
APP_ENV=development
API_PORT=8080
POSTGRES_PORT=5434
DATABASE_URL=postgres://fisca:fisca@localhost:5434/fisca?sslmode=disable

# Auth. Mode "dev" hanya untuk lokal (token: dev:<uuid>).
# Mode "jwt" memverifikasi RS256 dari provider (Supabase).
AUTH_MODE=session
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# AI (opsional). Tanpa OPENAI_API_KEY asisten memakai heuristik lokal.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Model STT harus sama dengan PRELOAD_MODELS di infra/docker-compose.yml.
OPENAI_STT_MODEL=Systran/faster-whisper-small
# STT lokal (speaches, port 9000). Mode Docker memakai http://stt:8000/v1 dan
# di-set langsung di compose; nilai ini hanya dipakai saat API jalan di host
# lewat `task dev`.
OPENAI_STT_BASE_URL=http://localhost:9000/v1
AI_TIMEOUT_SECONDS=20

# Perilaku finansial
BUDGET_WARNING_THRESHOLD=0.8
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
CORS_ORIGINS=http://localhost:3000

# web. Auth lokal (ISSUE-15) mengambil token dari POST /auth/login, jadi tidak
# ada lagi credential yang di-bake ke browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Dorman — hanya dipakai bila FISCA kelak memakai Supabase lagi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
